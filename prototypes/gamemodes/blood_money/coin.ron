            "SpriteTint": ((red: 0.859, green: 0.867, blue: 0.298, alpha: 1.0)),
            "Appearance": (
                sprite: (rsi: "textures/objects/coins", state: "coinshot"),
                depth: BelowMobs,
                // Out of the lighting multiply, so a magenta or green room cannot shift the yellow
                shading: Unshaded,
            ),
        },
    ),
]
