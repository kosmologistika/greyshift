[
    (
        type: "Entity",
        id: "coin_handful",
        components: {
            "DisplayName": (name: "handful of coins"),
            "CoinPile": (value: 1),
            "PlacementLayer": Free,
            // Thrown out of the victim like blood; the launch authors the
