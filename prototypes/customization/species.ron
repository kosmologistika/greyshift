// The one species. A profile names it so the file format holds when the
// next one lands; the lists are in prototypes/names
[
    (
        type: "Species",
        id: "human",
        body: "mob_human",
        min_age: 18,
        max_age: 90,
        // SS14's bands: young under 30, old from 60
        young_age: 30,
        old_age: 60,
        male_first_names: "names_first_male",
        female_first_names: "names_first_female",
        last_names: "names_last",
        // SS14's one human map: a one-texel waist pinch on the jumpsuit for
        // the female torso. The male cut is the sheet as drawn
        displacement: {
            Uniform: (female: Some((rsi: "textures/mobs/human_displacement", state: "jumpsuit-female"))),
        },
    ),
]
