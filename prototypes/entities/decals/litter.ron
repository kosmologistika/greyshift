[
    // FloorOverlay rather than BelowMobs so a dropped coin always draws over the junk
    (
        type: "Entity",
        id: "decal_debris",
        abstract: true,
        parents: ["base_decal_scatter"],
        components: {
            "DisplayName": (name: "ash"),
        },
    ),
    (
        type: "Entity",
        id: "decal_ash",
        parents: ["decal_debris"],
        components: {
            "Appearance": (sprite: (rsi: "textures/decals/debris", state: "ash")),
        },
    ),
    (
        type: "Entity",
        id: "decal_ash_big",
        parents: ["decal_debris"],
        components: {
            "Appearance": (sprite: (rsi: "textures/decals/debris", state: "ash_big")),
        },
    ),
    // Butts get lost on arcade carpet, so they belong on the tile ring around tables and slots
