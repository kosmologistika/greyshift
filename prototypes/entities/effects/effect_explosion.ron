            "PointLight": (color: (1.0, 0.6, 0.2), energy: 4.0, radius: 5.0, cast_shadows: false),
            "Appearance": (
                sprite: (rsi: "textures/effects/explosion", state: "explosionfast"),
                depth: Effects,
                shading: Unshaded,
            ),
        },
    ),
]
