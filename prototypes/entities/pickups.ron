[
    // Arena supply pads: walk-over stations that fire only when they change
    // something, then go dark for their respawn window. The numbers are
    // dials; maps place these like furniture.
    (
        type: "Entity",
        id: "base_pickup",
        abstract: true,
        components: {
            "Pickup": (sound: Some((source: Path("audio/effects/pickup_heal.ogg"), volume_db: -4.0, range_tiles: 12.0))),
            "Appearance": (depth: BelowMobs),
            "PlacementLayer": Free,
        },
    ),
    (
        type: "Entity",
        id: "pickup_medkit",
        parents: ["base_pickup"],
        components: {
            "DisplayName": (name: "medkit station"),
            "Pickup": (effect: FullHeal, respawn_secs: 30),
            "Appearance": (
                sprite: (rsi: "textures/objects/pickups", state: "pad_medkit"),
                // The rim skips the lighting multiply so its color code survives a colored room
                layers: [(state: "pad_medkit_glow", shading: Unshaded)],
            ),
        },
    ),
    (
        type: "Entity",
        id: "pickup_ammo",
        parents: ["base_pickup"],
        components: {
            "DisplayName": (name: "ammo crate"),
            "Pickup": (effect: RefillGuns, respawn_secs: 25),
            "Appearance": (
                sprite: (rsi: "textures/objects/pickups", state: "pad_ammo"),
                layers: [(state: "pad_ammo_glow", shading: Unshaded)],
            ),
        },
    ),
    (
        type: "Entity",
        id: "pickup_armor",
        parents: ["base_pickup"],
        components: {
            "DisplayName": (name: "armor rack"),
            "Pickup": (effect: Equip(["clothes_armor_vest", "clothes_helmet_sec"]), respawn_secs: 30),
            "Appearance": (
                sprite: (rsi: "textures/objects/pickups", state: "pad_armor"),
                layers: [(state: "pad_armor_glow", shading: Unshaded)],
            ),
        },
    ),
]
