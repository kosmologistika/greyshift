// Sound floors for weapons. A weapon inherits one of these so nothing is
// silent by default, and overrides the field where its own flavour differs -
// inheritance merges per field, so restating MeleeWeapon for shape and damage
// does not drop the sounds.
[
    (
        type: "Entity",
        id: "base_melee_weapon",
        abstract: true,
        components: {
            // One whoosh for every weapon, as SS14 does - it hardcodes a single
            // soundSwing default and no weapon overrides it. Plays on a miss
            // too: a swing goes whoosh whether or not it lands.
            "MeleeWeapon": (
                swing_sound: Some((source: Path("audio/weapons/swing.ogg"), volume_db: -14.0, pitch_var: 0.12, range_tiles: 9.0)),
                hit_sound: Some((source: Collection("melee_hit"), volume_db: -3.0, pitch_var: 0.08)),
            ),
        },
    ),
    (
        type: "Entity",
        id: "base_gun",
        abstract: true,
        components: {
            "Gun": (
                fire_sound: Some((source: Path("audio/weapons/guns/mk58.ogg"), volume_db: -2.0, pitch_var: 0.05, range_tiles: 24.0)),
            ),
        },
    ),
    (
        type: "Entity",
        id: "base_ballistic_projectile",
        abstract: true,
        components: {
            "ImpactFx": (
                sound: Some((source: Collection("bullet_ricochet"), volume_db: -8.0, pitch_var: 0.1, range_tiles: 10.0)),
            ),
        },
    ),
    (
        type: "Entity",
        id: "base_energy_projectile",
        abstract: true,
        components: {
            "ImpactFx": (
                sound: Some((source: Collection("energy_impact"), volume_db: -8.0, pitch_var: 0.1, range_tiles: 10.0)),
            ),
        },
    ),
]
