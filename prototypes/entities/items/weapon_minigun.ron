[
    (
        type: "Entity",
        id: "weapon_minigun",
        parents: ["base_gun"],
        components: {
            "DisplayName": (name: "minigun"),
            "Item": (size: Large),
            // Double the tg automatic pace (0.2s): the minigun must out-rate
