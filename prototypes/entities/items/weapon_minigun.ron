            "Gun": (fire_sound: Some((source: Path("audio/weapons/guns/minigun.ogg"), volume_db: -4.0, pitch_var: 0.05, range_tiles: 30.0)), fire_rate: 10.0, selected_mode: FullAuto, available_modes: [FullAuto]),
            "RecoilKick": (px: 2.0),
            "Container": (max_count: Some(1), max_item_size: Some(Large)),
            "SlotWhitelist": (tags: ["magazine_minigun"]),
            "InternalContainer": (),
            "SpreadConfig": (base: 0.1, growth_per_shot: 0.005, decay_per_sec: 2.0, max: 0.3),
            "Glidable": (),
            "PlacementLayer": Free,
            "Appearance": (
                sprite: (rsi: "textures/objects/weapons/guns/lmgs/l6", state: "icon"),
                depth: BelowMobs,
            ),
        },
    ),
    (
        type: "Entity",
        id: "weapon_minigun_loaded",
        parents: ["weapon_minigun"],
        components: {
            "StartingContents": (contents: ["minigun_drum"]),
