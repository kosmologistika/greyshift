[
    (
        type: "Entity",
        id: "weapon_energy_sword",
        parents: ["base_melee_weapon"],
        components: {
            "DisplayName": (name: "energy sword", desc: Some("item-desc-energy-sword")),
            "Item": (size: Small, held: Bundle),
            // Off it is a hilt: the swing whooshes and lands nothing
            "MeleeWeapon": (shape: Thrust(len: 1), damage: {}, cooldown: 0.5, icon_facing_deg: 45),
            "ItemToggle": (
                on_state: Some("icon"),
                on_weapon: Some((
                    shape: Thrust(len: 1), damage: {Slash: 40}, cooldown: 0.4, icon_facing_deg: 45,
                    swing_sound: Some((source: Path("audio/weapons/swing.ogg"), volume_db: -14.0, pitch_var: 0.12, range_tiles: 9.0)),
                    hit_sound: Some((source: Path("audio/weapons/slash.ogg"), volume_db: -3.0, pitch_var: 0.08)),
                )),
                on_guard: Some((reflect: 100)),
            ),
            "Appearance": (
                sprite: (rsi: "textures/objects/weapons/e_sword", state: "e_sword"),
            ),
        },
    ),
]
