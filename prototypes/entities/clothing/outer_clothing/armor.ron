[
    (
        type: "Entity",
        id: "clothes_armor_vest",
        parents: ["base_item"],
        components: {
            "DisplayName": (name: "armor vest", desc: Some("item-desc-armor-vest")),
            "Item": (size: Medium, strip_secs: 6.0, dress_secs: 4.0),
            "Clothing": (slots: [Suit], equip_secs: 2.0),
            // Piercing is the bullet axis and Heat the laser axis; arms are
            // covered so a pellet fan meets the plate more often than not
            "Armor": (covers: [Torso, Arm], block: {Blunt: 35, Slash: 70, Piercing: 70, Heat: 20}),
            "StruckSound": (default: Some((source: Path("audio/effects/block_metal1.ogg"), volume_db: -4.0, pitch_var: 0.1))),
            "Appearance": (
                sprite: (rsi: "textures/clothing/suits/armor_vest", state: "icon"),
            ),
        },
    ),
    (
        type: "Entity",
        id: "clothes_armor_ablative",
        parents: ["base_item"],
        components: {
            "DisplayName": (name: "ablative vest"),
            "Item": (size: Medium, strip_secs: 6.0, dress_secs: 4.0),
            "Clothing": (slots: [Suit], equip_secs: 2.0),
            // The anti-laser pick: a bullet barely notices it, a bolt has an
            // even chance of coming straight back at whoever fired it, wherever
            // on the wearer it would have landed
            "Armor": (covers: [Torso, Arm], block: {Blunt: 10, Slash: 10, Piercing: 10, Heat: 70}, reflect: 50),
            "StruckSound": (default: Some((source: Path("audio/effects/block_metal1.ogg"), volume_db: -4.0, pitch_var: 0.1))),
            "Appearance": (
                sprite: (rsi: "textures/clothing/suits/armor_reflec", state: "icon"),
            ),
        },
    ),
]
