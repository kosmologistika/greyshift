// Wall-mounted fixtures. The entity sits on the *floor* tile beside the wall,
// not on the wall itself: the tile stays walkable, and the wall is a neighbouring
// occluder cell so shadows fall right with `PointLight.offset` left at zero.
// `Facing` names the wall it hangs on, and the RSI's frame for that direction is
// already drawn against that edge of the cell - which is why no sprite offset
// exists anywhere. Colours are linear RGB; (1.0, 0.776, 0.617) is SS14's 5000K
// #FFE4CE converted.
[
    (
        type: "Entity",
        id: "light_wall",
        abstract: true,
        components: {
            "WallMount": (),
            "PlacementLayer": WallMount,
            "Facing": (South),
            // No `Damageable`, so nothing can reach this trigger yet: the
            // fixture stands on walkable floor and would eat every swing and
            // stray round aimed at that tile. #203 moves where it is struck,
            // and the 10 goes live then - glass on a bracket, against a
            // table's 40 and a wall's 150. `Demolish` ignores the trigger and
            // runs the behaviors, which is what breaks it with its wall.
            "Destructible": (thresholds: [
                (
                    trigger: TotalDamage(10),
                    behaviors: [
                        PlaySound((source: Collection("destroy_window"), volume_db: -2.0, pitch_var: 0.08)),
                        SpawnEntities({"item_glass_shard": (min: 1, max: 1)}),
                        Destroy,
                    ],
                ),
            ]),
            "Appearance": (depth: WallMounted),
        },
    ),
    (
        type: "Entity",
        id: "light_wall_tube",
        parents: ["light_wall"],
        components: {
            "DisplayName": (name: "light tube"),
            "PointLight": (color: (1.0, 0.776, 0.617), energy: 1.5, radius: 8.0),
            "Appearance": (
                sprite: (rsi: "textures/structures/lighting/light_tube", state: "base"),
                // The lit part of the fixture, drawn over the housing and out
                // of the lighting multiply. Without it a lamp is a grey bar in
                // the dark room it is supposed to be lighting. The soft glow
                // over it is a sprite rather than a screen-space quad, so it
                // hangs on the fixture and line of sight hides it with the
                // fixture - it cannot spill past the wall the light stops at
                layers: [
                    (state: "glow", shading: Unshaded),
                    (rsi: Some("textures/effects/light_glow"), state: "glow", shading: Unshaded),
                ],
            ),
        },
    ),
    (
        type: "Entity",
        id: "light_wall_small",
        parents: ["light_wall"],
        components: {
            "DisplayName": (name: "small light"),
            "PointLight": (color: (1.0, 0.776, 0.617), energy: 0.9, radius: 4.5),
            "Appearance": (
                sprite: (rsi: "textures/structures/lighting/light_small", state: "base"),
                layers: [
                    (state: "glow", shading: Unshaded),
                    (rsi: Some("textures/effects/light_glow"), state: "glow", shading: Unshaded),
                ],
            ),
        },
    ),
]
