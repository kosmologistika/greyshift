[
    (
        type: "Entity",
        id: "mob_human",
        components: {
            "DisplayName": (name: "human"),
            "Mob": (),
            "Movable": (),
            "Glidable": (),
            "Pullable": (),
            "Crawler": (),
            "Damageable": (),
            "MobThresholds": (thresholds: {0: Alive, 100: Dead}),
            "Body": (
                parts: ["part_head", "part_arm_left", "part_arm_right", "part_leg_left", "part_leg_right"],
                torso_weight: 40,
            ),
            // Art steps authored at 10..100; the last moves down to 85 so the
            // worst state reads "one hit from death" on someone still standing
            // instead of only dressing corpses.
            "DamageVisuals": (overlays: {
                // The brute masters are grayscale; SS14 paints them #FF0000
                // at draw time, and unpainted they read as soot.
                Brute: (rsi: "textures/mobs/effects/brute_damage", tint: Some((red: 1.0, green: 0.0, blue: 0.0, alpha: 1.0)), steps: [
                    (at: 10, state: "brute_10"),
                    (at: 20, state: "brute_20"),
                    (at: 30, state: "brute_30"),
                    (at: 50, state: "brute_50"),
                    (at: 70, state: "brute_70"),
                    (at: 85, state: "brute_100"),
                ]),
                Burn: (rsi: "textures/mobs/effects/burn_damage", steps: [
                    (at: 10, state: "burn_10"),
                    (at: 20, state: "burn_20"),
                    (at: 30, state: "burn_30"),
                    (at: 50, state: "burn_50"),
                    (at: 70, state: "burn_70"),
                    (at: 85, state: "burn_100"),
                ]),
            }),
            "MeleeWeapon": (
                shape: Thrust(len: 1), damage: {Blunt: 5}, cooldown: 0.5,
                swing_sound: Some((source: Path("audio/weapons/swing.ogg"), volume_db: -18.0, pitch_var: 0.12, range_tiles: 9.0)),
                hit_sound: Some((source: Collection("unarmed_hit"), volume_db: -6.0, pitch_var: 0.1)),
            ),
            // A laser sears, a bullet thuds, a blade opens and a fist slaps -
            // the blow decides, not the body. Beats whatever struck it, so a
            // bullet into a person is never a ricochet off steel.
            "StruckSound": (
                by_type: {
                    Heat: (source: Collection("flesh_seared"), volume_db: -4.0, pitch_var: 0.1),
                    Piercing: (source: Collection("flesh_pierced"), volume_db: -4.0, pitch_var: 0.1),
                    Slash: (source: Path("audio/weapons/slash.ogg"), volume_db: -4.0, pitch_var: 0.1),
                    Blunt: (source: Path("audio/effects/meatslap.ogg"), volume_db: -4.0, pitch_var: 0.1),
                },
                // A hook carries no DamageOnHit, so it has no dominant type to
                // look up. Without this a body hit by one lands in silence.
                default: Some((source: Path("audio/effects/meatslap.ogg"), volume_db: -6.0, pitch_var: 0.1)),
            ),
            "Footsteps": (
                crawl: Some((source: Path("audio/footsteps/crawl1.ogg"), volume_db: -16.0, pitch_var: 0.05, range_tiles: 3.0)),
            ),
            "Voice": ("human"),
            "Deathgasp": (),
            "PainScream": (),
            "Hands": (),
            "Eyes": (),
            // Composed from the syndicate part sheets so a severed part can
            // vanish from the sprite (client body_visuals toggles the keyed
            // layers). The base "full" state stays for anything that reads
            // the base sprite as an icon; hide_base keeps it off the map.
            // The sheets are pre-colored - no tint, a multiply turns them brown.
            "Appearance": (
                sprite: (rsi: "textures/mobs/human_parts", state: "full"),
                depth: Mobs,
                hide_base: true,
                layers: [
                    (state: "l_leg", key: Some("part_leg_left"), order: -5),
                    (state: "r_leg", key: Some("part_leg_right"), order: -5),
                    (state: "torso_m", order: -4),
                    (state: "l_arm", key: Some("part_arm_left"), order: -3),
                    (state: "r_arm", key: Some("part_arm_right"), order: -3),
                    (state: "head_m", key: Some("part_head"), order: -2),
                ],
            ),
        },
    ),
]
