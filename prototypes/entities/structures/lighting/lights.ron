[
    // Flush with the floor on the Free layer, so it lights open space without standing in it as cover
    (
        type: "Entity",
        id: "light_floor_flush",
        components: {
            "DisplayName": (name: "floor light"),
            "PointLight": (color: (1.0, 0.776, 0.617), energy: 1.2, radius: 6.0),
            "PlacementLayer": Free,
            "Appearance": (
                sprite: (rsi: "textures/structures/lighting/light_floor", state: "base"),
                depth: Furniture,
                layers: [
                    (state: "glow", shading: Unshaded, tint: Some((red: 1.0, green: 0.92, blue: 0.8, alpha: 1.0))),
                ],
            ),
        },
    ),
    (
        type: "Entity",
        id: "light_floor_flush_red",
        parents: ["light_floor_flush"],
        components: {
            "PointLight": (color: (1.0, 0.1, 0.12), energy: 1.8),
            "Appearance": (layers: [
                (rsi: Some("textures/structures/lighting/light_floor"), state: "glow", shading: Unshaded, tint: Some((red: 1.0, green: 0.3, blue: 0.3, alpha: 1.0))),
            ]),
        },
    ),
    (
        type: "Entity",
        id: "light_floor_flush_magenta",
        parents: ["light_floor_flush"],
        components: {
            "PointLight": (color: (1.0, 0.15, 0.7), energy: 1.7),
            "Appearance": (layers: [
                (rsi: Some("textures/structures/lighting/light_floor"), state: "glow", shading: Unshaded, tint: Some((red: 1.0, green: 0.4, blue: 0.85, alpha: 1.0))),
            ]),
        },
    ),
    (
        type: "Entity",
        id: "light_lamp_green",
        components: {
            "DisplayName": (name: "banker's lamp"),
            "PointLight": (color: (0.7, 1.0, 0.4), energy: 1.0, radius: 4.0),
            // Free, so it can stand on a table tile
            "PlacementLayer": Free,
            "Facing": (South),
            "Appearance": (
                sprite: (rsi: "textures/structures/lighting/lamp_green", state: "lampgreen"),
                depth: BelowMobs,
                layers: [
                    (state: "lampgreen-on", shading: Unshaded),
                ],
            ),
        },
    ),
    (
        type: "Entity",
        id: "light_lantern",
        components: {
            "DisplayName": (name: "lantern"),
            "PointLight": (color: (1.0, 0.55, 0.2), energy: 1.0, radius: 4.0),
            // Free, so it can stand on a bench or tray tile
            "PlacementLayer": Free,
            "Appearance": (
                sprite: (rsi: "textures/structures/lighting/lantern", state: "base"),
                depth: BelowMobs,
            ),
        },
    ),
    (
        type: "Entity",
        id: "light_sunlamp",
        parents: ["light"],
        components: {
            "DisplayName": (name: "sunlamp"),
            "PointLight": (color: (1.0, 0.82, 0.5), energy: 3.0, radius: 9.0),
            "Appearance": (
                sprite: (rsi: "textures/structures/lighting/sunlamp", state: "base"),
            ),
        },
    ),
]
