[
    // Walls and windows close their frames onto anything with this parent
    (
        type: "Entity",
        id: "structure_door_frame_base",
        abstract: true,
        components: {
            "AreaBoundary": (),
            "IconSmooth": (key: "wall", mode: NoSprite),
        },
    ),
    // What every door is before it has a motor or a material: it fills its
    // cell and can be broken down
    (
        type: "Entity",
        id: "structure_door_base",
        abstract: true,
        parents: ["structure_door_frame_base"],
        components: {
            // No DoorSafety here: each door kind says whether it has the
            // obstruction sensor, since a firelock is built without one
            "Damageable": (),
            "Door": (state: Closed, open_secs: 0.6, close_secs: 0.6, deny_secs: 0.6),
            "DoorSounds": (
                open: Some((source: Path("audio/machines/airlock_open.ogg"), volume_db: -4.0)),
                close: Some((source: Path("audio/machines/airlock_close.ogg"), volume_db: -4.0)),
                deny: Some((source: Path("audio/machines/airlock_deny.ogg"), volume_db: -6.0)),
            ),
            "PlacementLayer": Solid,
            "Appearance": (depth: Doors),
        },
    ),
]
