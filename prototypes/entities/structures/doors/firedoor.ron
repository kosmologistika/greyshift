[
    // A real door that rests open and is worked by the gas model: it drops
    // while a zone beside it is depressurised and lifts once both are back.
    // No motor to bump, no auto-close and no safety: it shuts on whoever is
    // in the frame, and a dropped one is pried, by hand through a windup or
    // at once with a crowbar
    (
        type: "Entity",
        id: "structure_firelock_base",
        abstract: true,
        parents: ["structure_door_base"],
        components: {
            "Door": (state: Open, auto_close_secs: None, open_secs: 1.2, close_secs: 1.2, deny_secs: 0.6),
            "Firelock": (pry_secs: 3.0, hold_secs: 2.0),
            "CrushDamage": ({Blunt: 15}),
            // Shares an airlock's cell, so not on the one-per-cell solid layer
            "PlacementLayer": Free,
            "StruckSound": (default: Some((source: Collection("hit_metal"), volume_db: -4.0, pitch_var: 0.1))),
            "Destructible": (thresholds: [
                (
                    trigger: TotalDamage(150),
                    behaviors: [PlaySound((source: Collection("destroy_metal"), volume_db: -2.0, pitch_var: 0.08)), Destroy],
                ),
            ]),
        },
    ),
    (
        type: "Entity",
        id: "structure_firedoor",
        parents: ["structure_firelock_base"],
        components: {
            "DisplayName": (name: "firelock"),
            "Door": (glass: true),
            "Appearance": (sprite: (rsi: "textures/structures/doors/firedoor", state: "open"), depth: FloorFixture),
        },
    ),
    (
        type: "Entity",
        id: "structure_firedoor_border_only",
        parents: ["structure_firelock_base"],
        components: {
            "DisplayName": (name: "firelock"),
            "Door": (glass: true),
            "Appearance": (sprite: (rsi: "textures/structures/doors/firedoor_border_only", state: "open"), depth: FloorFixture),
        },
    ),
    (
        type: "Entity",
        id: "structure_firedoor_heavy",
        parents: ["structure_firelock_base"],
        components: {
            "DisplayName": (name: "heavy firelock"),
            "Appearance": (sprite: (rsi: "textures/structures/doors/firedoor_heavy", state: "open"), depth: FloorFixture),
        },
    ),
]
