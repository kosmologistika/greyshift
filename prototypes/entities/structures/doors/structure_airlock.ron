[
    (
        type: "Entity",
        id: "structure_airlock",
        parents: ["structure_door_base"],
        components: {
            "DisplayName": (name: "airlock", desc: Some("item-desc-airlock")),
            "Door": (auto_close_secs: Some(5.0)),
            // Opens for whoever walks into it, and wears the status lights
            // that say why when it doesn't.
            "BumpOpen": (),
            "Airlock": (),
            // What the door does to whoever is in it when the safety is cut
            "CrushDamage": ({Blunt: 15}),
            "StruckSound": (default: Some((source: Collection("hit_metal"), volume_db: -4.0, pitch_var: 0.1))),
            "Destructible": (thresholds: [
                (
                    trigger: TotalDamage(100),
                    behaviors: [PlaySound((source: Collection("destroy_metal"), volume_db: -2.0, pitch_var: 0.08)), Destroy],
                ),
            ]),
            "Appearance": (
                sprite: (rsi: "textures/structures/doors/airlock", state: "closed"),
                // The status light, over the body and out of the lighting
                // multiply so it reads in a dark corridor. Which `*_unlit`
                // state it shows, and whether it shows at all, is the client's
                // answer to the door's state - a closed airlock with nothing
                // to report hides it
                layers: [
                    (key: Some("light"), state: "deny_unlit", shading: Unshaded, visible: false),
                ],
            ),
        },
    ),
]
