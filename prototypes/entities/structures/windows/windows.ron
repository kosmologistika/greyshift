[
    (
        type: "Entity",
        id: "structure_window",
        parents: ["base_structure_solid"],
        components: {
            "DisplayName": (name: "window"),
            "AreaBoundary": (),
            // Lights and cameras hang on full-tile glass along station corridors
            "MountSupport": (),
            // Lasers fly through glass untouched; bullets still stop and
            // break it.
            "PassesEnergyProjectiles": (),
            "StruckSound": (default: Some((source: Collection("hit_glass"), volume_db: -4.0, pitch_var: 0.1))),
            "Damageable": (),
            // All, not Brute: a laser cracks glass like a crowbar does.
            "DamageVisuals": (overlays: {
                All: (rsi: "textures/structures/windows/cracks", steps: [
                    (at: 10, state: "cracks_1"),
                    (at: 25, state: "cracks_2"),
                    (at: 40, state: "cracks_3"),
                ]),
            }),
            "Destructible": (thresholds: [
                (
                    trigger: TotalDamage(50),
                    behaviors: [
                        PlaySound((source: Collection("destroy_window"), volume_db: -2.0, pitch_var: 0.08)),
                        SpawnEntities({"item_glass_shard": (min: 1, max: 2)}),
                        Destroy,
                    ],
                ),
            ]),
            // joins the wall run it sits in, the way tg's smoothing groups do
            "IconSmooth": (key: "wall", state_prefix: "window"),
            "Appearance": (
                sprite: (rsi: "textures/structures/windows/window", state: "full"),
                // over a shutter or blast door on its tile, as tg stacks them
                depth: Doors,
            ),
        },
    ),
    (
        type: "Entity",
        id: "structure_window_thin",
        parents: ["structure_window"],
        components: {
            // Crack stages rescaled to the weaker pane, or it breaks after showing only the first
            "DamageVisuals": (overlays: {
                All: (rsi: "textures/structures/windows/cracks", steps: [
                    (at: 5, state: "cracks_1"),
                    (at: 12, state: "cracks_2"),
                    (at: 20, state: "cracks_3"),
                ]),
            }),
            // Half a station pane: four pistol rounds open a sightline mid-fight
            "Destructible": (thresholds: [
                (
                    trigger: TotalDamage(25),
                    behaviors: [
                        PlaySound((source: Collection("destroy_window"), volume_db: -2.0, pitch_var: 0.08)),
                        SpawnEntities({"item_glass_shard": (min: 1, max: 2)}),
                        Destroy,
                    ],
                ),
            ]),
        },
    ),
]
