[
    (
        type: "Entity",
        id: "structure_window",
        components: {
            "DisplayName": (name: "window"),
            "Solid": (),
            "BlocksAttack": (),
            // Lasers fly through glass untouched; bullets still stop and
            // break it.
            "PassesEnergyProjectiles": (),
            "StruckSound": (default: Some((source: Collection("hit_glass"), volume_db: -4.0, pitch_var: 0.1))),
            "Damageable": (),
            // All, not Brute: a laser cracks glass like a crowbar does.
            "DamageVisuals": (overlays: {
                All: (rsi: "textures/structures/windows/cracks", steps: [
                    (at: 10, state: "cracks_1"),
                    (at: 25, state: "cracks_2"),
                    (at: 40, state: "cracks_3"),
                ]),
            }),
            "Destructible": (thresholds: [
                (
                    trigger: TotalDamage(50),
                    behaviors: [
                        PlaySound((source: Collection("destroy_window"), volume_db: -2.0, pitch_var: 0.08)),
                        SpawnEntities({"item_glass_shard": (min: 1, max: 2)}),
                        Destroy,
                    ],
                ),
            ]),
            "PlacementLayer": Solid,
            "IconSmooth": (key: "window", state_prefix: "window"),
            "Appearance": (
                sprite: (rsi: "textures/structures/windows/window", state: "full"),
                depth: Walls,
            ),
        },
    ),
]
