[
    // Painted onto the wall's own tile like wall blood, so place it on the wall cell
    (
        type: "Entity",
        id: "structure_sign",
        abstract: true,
        components: {
            "PlacementLayer": Free,
            "Appearance": (depth: WallOverlay),
        },
    ),
    (
        type: "Entity",
        id: "structure_sign_games",
        parents: ["structure_sign"],
        components: {
            "DisplayName": (name: "games sign"),
            "Appearance": (sprite: (rsi: "textures/structures/decoration/signs", state: "arcade")),
        },
    ),
    (
        type: "Entity",
        id: "structure_sign_bar",
        parents: ["structure_sign"],
        components: {
            "DisplayName": (name: "bar sign"),
            "Appearance": (sprite: (rsi: "textures/structures/decoration/signs", state: "bar")),
        },
    ),
    (
        type: "Entity",
        id: "structure_sign_vault",
        parents: ["structure_sign"],
        components: {
            "DisplayName": (name: "vault sign"),
            "Appearance": (sprite: (rsi: "textures/structures/decoration/signs", state: "vault")),
        },
    ),
]
