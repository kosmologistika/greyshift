            "Item": (size: Small),
            "GrantsActions": (ids: ["action_fire_mode"], to: Holder),
            "Gun": (fire_rate: 3.0, available_modes: [SemiAuto, Burst(count: 2, internal_rate: 14.0)]),
            "RecoilKick": (px: 8.0),
            "Container": (max_count: Some(2)),
            "OpensByHand": (),
            "SpreadConfig": (base: 0.28, max: 0.45),
            "Appearance": (
                sprite: (rsi: "textures/objects/weapons/guns/shotguns/sawn", state: "icon"),
            ),
        },
    ),
    (
        type: "Entity",
        id: "weapon_shotgun_sawn_loaded",
        parents: ["weapon_shotgun_sawn"],
        components: {
            "StartingContents": (contents: ["ammo_shell_buckshot", "ammo_shell_buckshot"]),
        },
