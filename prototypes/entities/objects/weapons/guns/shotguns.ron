[
    (
        type: "Entity",
        id: "weapon_shotgun_double",
        parents: ["base_shotgun"],
        components: {
            "DisplayName": (name: "double-barreled shotgun"),
            "Item": (size: Large),
            // Burst(2) is both barrels on one pull; the fire-mode verb picks
            // between it and one barrel at a time.
            "GrantsActions": (ids: ["action_fire_mode"], to: Holder),
            "Gun": (fire_rate: 3.0, available_modes: [SemiAuto, Burst(count: 2, internal_rate: 14.0)]),
            "RecoilKick": (px: 6.0),
            "Container": (max_count: Some(2)),
            "OpensByHand": (),
            "SpreadConfig": (base: 0.2, max: 0.3),
            "Appearance": (
                sprite: (rsi: "textures/objects/weapons/guns/shotguns/db_shotgun", state: "icon"),
            ),
        },
    ),
    (
        type: "Entity",
        id: "weapon_shotgun_double_loaded",
        parents: ["weapon_shotgun_double"],
        components: {
            "StartingContents": (contents: ["ammo_shell_buckshot", "ammo_shell_buckshot"]),
        },
    ),
    (
        type: "Entity",
        id: "weapon_shotgun_pump",
        parents: ["base_shotgun"],
        components: {
            "DisplayName": (name: "pump shotgun", desc: Some("item-desc-shotgun-pump")),
            "Item": (size: Large),
            "Gun": (fire_rate: 2.0, available_modes: [SemiAuto]),
            "RecoilKick": (px: 6.0),
            "Container": (max_count: Some(4)),
            "ManualCycle": (rack_sound: Some((source: Path("audio/weapons/guns/batrifle_cock.ogg"), volume_db: -4.0, pitch_var: 0.05, range_tiles: 10.0))),
            "SpreadConfig": (base: 0.2, max: 0.3),
            "Appearance": (
                sprite: (rsi: "textures/objects/weapons/guns/shotguns/pump", state: "icon"),
            ),
        },
    ),
    (
        type: "Entity",
        id: "weapon_shotgun_pump_loaded",
        parents: ["weapon_shotgun_pump"],
        components: {
            "StartingContents": (contents: ["ammo_shell_buckshot", "ammo_shell_buckshot", "ammo_shell_buckshot", "ammo_shell_buckshot"]),
        },
    ),
    (
        type: "Entity",
        id: "weapon_shotgun_sawn",
        parents: ["base_shotgun"],
        components: {
            "DisplayName": (name: "sawn-off shotgun"),
            // Small is the whole point: it hides in a bag, and the wild cone
