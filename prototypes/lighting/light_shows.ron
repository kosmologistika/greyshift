[
    // Every light in a depressurised zone breathes amber: a slow swell, well
    // under the flash cap, red kept back for fire. `quiet` at 1 since no
    // track drives it
    (
        type: "LightShow",
        id: "show_depressurised",
        bpm: 40.0,
        channels: {
            "alarm": (low: 0.5, quiet: 1.0, colors: [(1.0, 0.55, 0.1)]),
        },
    ),
    (
        type: "LightShow",
        id: "casino",
        bpm: 143.26,
        channels: {
            "swell": (low: 0.45),
            "chop_a": (shape: Chop, group: 0),
            "chop_b": (shape: Chop, group: 1),
            // No yellow, orange or white, so a dropped coin never matches the panel under it
            "floor": (
                low: 0.7,
                scatter: true,
                colors: [
                    (0.1, 0.9, 1.0),
                    (1.0, 0.15, 0.75),
                    (0.2, 0.35, 1.0),
                    (0.2, 1.0, 0.35),
                    (0.65, 0.4, 1.0),
                    (1.0, 0.15, 0.2),
                ],
            ),
        },
    ),
]
