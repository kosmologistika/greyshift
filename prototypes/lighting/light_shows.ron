[
    // Every fixture in a depressurised zone turns emergency light, tg's way:
    // the room goes dark but for a narrow alarm-orange cone each one sweeps
    // round, red kept back for fire. Steady, so `low` at 1 and `quiet` at 1
    // since no track drives it
    (
        type: "LightShow",
        id: "show_depressurised",
        bpm: 40.0,
        channels: {
            "alarm": (
                low: 1.0,
                quiet: 1.0,
                colors: [(1.0, 0.25, 0.05)],
                arc_degrees: Some(70.0),
                spin_degrees_per_sec: 60.0,
            ),
        },
    ),
    (
        type: "LightShow",
        id: "casino",
        bpm: 143.26,
        channels: {
            "swell": (low: 0.45),
            "chop_a": (shape: Chop, group: 0),
            "chop_b": (shape: Chop, group: 1),
            // No yellow, orange or white, so a dropped coin never matches the panel under it
            "floor": (
                low: 0.7,
                scatter: true,
                colors: [
                    (0.1, 0.9, 1.0),
                    (1.0, 0.15, 0.75),
                    (0.2, 0.35, 1.0),
                    (0.2, 1.0, 0.35),
                    (0.65, 0.4, 1.0),
                    (1.0, 0.15, 0.2),
                ],
            ),
        },
    ),
]
