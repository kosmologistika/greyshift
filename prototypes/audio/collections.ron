// A collection is picked from by a rotating cursor, so consecutive plays always
// differ. Adding a take is a one-line edit here rather than a change to every
// prototype that makes the noise.
[
    (
        type: "SoundCollection",
        id: "melee_hit",
        files: [
            "audio/weapons/genhit3.ogg",
            "audio/weapons/slash.ogg",
            "audio/weapons/pierce.ogg",
        ],
    ),
    (
        type: "SoundCollection",
        id: "unarmed_hit",
        files: [
            "audio/weapons/boxingpunch1.ogg",
            "audio/weapons/boxingpunch2.ogg",
            "audio/weapons/boxingpunch3.ogg",
        ],
    ),
    (
        type: "SoundCollection",
        id: "bullet_ricochet",
        files: [
            "audio/weapons/guns/ric1.ogg",
            "audio/weapons/guns/ric2.ogg",
            "audio/weapons/guns/ric3.ogg",
            "audio/weapons/guns/ric5.ogg",
        ],
    ),
    (
        type: "SoundCollection",
        id: "energy_impact",
        files: [
            "audio/weapons/guns/energy_metal1.ogg",
            "audio/weapons/guns/energy_metal2.ogg",
        ],
    ),
    // SS14's GlassSmack: what a window makes when struck. Their glass_crack
    // set is the destruction sound, which is a different event.
    (
        type: "SoundCollection",
        id: "hit_glass",
        files: ["audio/effects/glass_smack.ogg"],
    ),
    (
        type: "SoundCollection",
        id: "hit_metal",
        files: [
            "audio/effects/metal_thud1.ogg",
            "audio/effects/metal_thud2.ogg",
            "audio/effects/metal_thud3.ogg",
        ],
    ),
    // SS14 uses a boxing punch for its wooden structures; its chop.ogg is
    // unattributed upstream and wood_destroy is again a destruction sound.
    (
        type: "SoundCollection",
        id: "hit_wood",
        files: ["audio/weapons/boxingpunch1.ogg"],
    ),
    (
        type: "SoundCollection",
        id: "flesh_pierced",
        files: [
            "audio/effects/bullet_meat1.ogg",
            "audio/effects/bullet_meat2.ogg",
            "audio/effects/bullet_meat3.ogg",
            "audio/effects/bullet_meat4.ogg",
