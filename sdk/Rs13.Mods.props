<Project>
  <!-- A mod project imports this: the SDK compiles in as sources beside the bindings
       componentize-dotnet generates from the same WIT, and the SDK generator writes
       the module's registrations from the attributes on its types -->
  <PropertyGroup>
    <!-- the engine's mod-build hands the WIT and the generator in; a build from the
         content repository's sdk/ finds the WIT beside this file and builds the generator -->
    <Rs13SdkWit Condition="'$(SdkWit)' != ''">$(SdkWit)</Rs13SdkWit>
    <Rs13SdkWit Condition="'$(Rs13SdkWit)' == '' and Exists('$(MSBuildThisFileDirectory)wit')">$(MSBuildThisFileDirectory)wit</Rs13SdkWit>
    <Rs13SdkWit Condition="'$(Rs13SdkWit)' == ''">$(MSBuildThisFileDirectory)../sdk/wit</Rs13SdkWit>
    <Rs13GeneratorProject>$(MSBuildThisFileDirectory)Generators/Rs13.Mods.Generators.csproj</Rs13GeneratorProject>
    <Rs13Generator Condition="'$(Rs13Generator)' == '' and '$(Rs13SdkWit)' == '$(MSBuildThisFileDirectory)../sdk/wit' and Exists('$(MSBuildThisFileDirectory)../../target/mod-sdk/Rs13.Mods.Generators.dll')">$(MSBuildThisFileDirectory)../../target/mod-sdk/Rs13.Mods.Generators.dll</Rs13Generator>
    <Rs13BuildsGenerator Condition="'$(Rs13Generator)' == ''">true</Rs13BuildsGenerator>
    <Rs13Generator Condition="'$(Rs13Generator)' == ''">$(MSBuildThisFileDirectory)Generators/bin/Release/netstandard2.0/Rs13.Mods.Generators.dll</Rs13Generator>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)*.cs" />
    <Analyzer Include="$(Rs13Generator)" />
    <Wit Remove="**\*.wit" />
    <Wit Include="$(Rs13SdkWit)" World="typed-module" />
  </ItemGroup>

  <!-- every build, so a republished generator is picked up; restore and build are two
       evaluations, since one call would build against an unrestored project -->
  <Target Name="Rs13BuildGenerator" BeforeTargets="CoreCompile" Condition="'$(Rs13BuildsGenerator)' == 'true'">
    <MSBuild Projects="$(Rs13GeneratorProject)" Targets="Restore" Properties="Configuration=Release;Rs13Restoring=true" />
    <MSBuild Projects="$(Rs13GeneratorProject)" Targets="Build" Properties="Configuration=Release" />
  </Target>

  <!-- System.Text.Json's generator cannot see what another generator emits, so the
       module's JSON contexts are written as plain source before compile. The scan is
       textual; the generator errors on any registered type the contexts lack -->
  <UsingTask TaskName="Rs13WriteJsonContexts" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Output ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
var declaration = new Regex(@"((?:\[[^\]]*\]\s*)+)((?:(?:public|internal|private|protected|sealed|partial|abstract|static)\s+)*)(?:class|record(?:\s+class)?)\s+(?!struct\b)(\w+)", RegexOptions.Compiled);
var ownAttribute = new Regex(@"\b(RegisterComponent|RegisterResource|NetSerializable)\b", RegexOptions.Compiled);
var mirrorAttribute = new Regex(@"\bMirrorComponent\b", RegexOptions.Compiled);
var namespaces = new Regex(@"^\s*namespace\s+([\w.]+)\s*[;{]", RegexOptions.Compiled | RegexOptions.Multiline);
var comments = new Regex(@"/\*.*?\*/|//[^\n]*", RegexOptions.Compiled | RegexOptions.Singleline);
var own = new List<string>();
var mirrors = new List<string>();
foreach (var source in Sources)
{
    var path = source.GetMetadata("FullPath");
    if (!File.Exists(path) || path.EndsWith(".g.cs"))
    {
        continue;
    }
    // Comments go, with their length kept so namespace positions still line up
    var text = comments.Replace(File.ReadAllText(path), m => new string(' ', m.Length));
    var declared = namespaces.Matches(text);
    foreach (Match m in declaration.Matches(text))
    {
        if (m.Groups[2].Value.Contains("static"))
        {
            continue;
        }
        var prefix = "";
        foreach (Match ns in declared)
        {
            if (ns.Index < m.Index)
            {
                prefix = ns.Groups[1].Value + ".";
            }
        }
        var attributes = m.Groups[1].Value;
        var type = "global::" + prefix + m.Groups[3].Value;
        if (ownAttribute.IsMatch(attributes))
        {
            own.Add(type);
        }
        else if (mirrorAttribute.IsMatch(attributes))
        {
            mirrors.Add(type);
        }
    }
}
var text2 = new StringBuilder();
text2.AppendLine("// <auto-generated/> Rs13.Mods.props, from the attributes on the module's types");
text2.AppendLine("using System.Text.Json.Serialization;");
text2.AppendLine("namespace Rs13.Mods");
text2.AppendLine("{");
if (own.Count > 0)
{
    text2.AppendLine("    [JsonSourceGenerationOptions(PropertyNamingPolicy = JsonKnownNamingPolicy.SnakeCaseLower, UseStringEnumConverter = true, IncludeFields = true,");
    text2.AppendLine("        UnmappedMemberHandling = JsonUnmappedMemberHandling.Disallow, Converters = new[] { typeof(global::Rs13.Mods.SerdeDurationJson), typeof(global::Rs13.Mods.Vector2Json) })]");
    foreach (var type in own)
    {
        text2.AppendLine("    [JsonSerializable(typeof(" + type + "))]");
    }
    text2.AppendLine("    internal sealed partial class ModJson : JsonSerializerContext { }");
}
if (mirrors.Count > 0)
{
    text2.AppendLine("    [JsonSourceGenerationOptions(PropertyNamingPolicy = JsonKnownNamingPolicy.SnakeCaseLower, UseStringEnumConverter = true, IncludeFields = true,");
    text2.AppendLine("        UnmappedMemberHandling = JsonUnmappedMemberHandling.Skip, Converters = new[] { typeof(global::Rs13.Mods.SerdeDurationJson), typeof(global::Rs13.Mods.Vector2Json) })]");
    foreach (var type in mirrors)
    {
        text2.AppendLine("    [JsonSerializable(typeof(" + type + "))]");
    }
    text2.AppendLine("    internal sealed partial class MirrorJson : JsonSerializerContext { }");
}
text2.AppendLine("}");
var content = text2.ToString();
Directory.CreateDirectory(Path.GetDirectoryName(Output));
if (!File.Exists(Output) || File.ReadAllText(Output) != content)
{
    File.WriteAllText(Output, content);
}
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="Rs13JsonContexts" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <Rs13JsonContexts>$(IntermediateOutputPath)rs13/ModJson.g.cs</Rs13JsonContexts>
    </PropertyGroup>
    <Rs13WriteJsonContexts Sources="@(Compile)" Output="$(Rs13JsonContexts)" />
    <ItemGroup>
      <Compile Include="$(Rs13JsonContexts)" />
    </ItemGroup>
  </Target>
</Project>
