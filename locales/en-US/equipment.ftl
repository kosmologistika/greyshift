strip-warn-take = { $actor } tries to remove your { $item }.
    .popup = { $actor } tugs at your { $item }!
strip-warn-dress = { $actor } tries to put { $item } on you.
    .popup = { $actor } puts { $item } on you!
strip-warn-pocket = Someone fumbles with your pocket.
    .popup = someone is at your pocket!
smart-equip-no-slot = You have no such slot.
    .popup = no such slot!
smart-equip-empty = Nothing there, and nothing in hand.
    .popup = nothing there!
strip-warn-hand = { $actor } tries to put { $item } in your hand.
    .popup = { $actor } pushes { $item } at your hand!
strip-warn-grip = { $actor } tries to pry your hand loose.
    .popup = { $actor } pries at your grip!
strip-denied-busy = Your hands are busy.
    .popup = hands busy!
strip-window-title = Stripping { $name }
