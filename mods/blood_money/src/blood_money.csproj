<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BloodMoney</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <UseAppHost>false</UseAppHost>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <AssemblyName>blood_money</AssemblyName>
    <!-- mod-build hands the compiler package's host in, see tools/mod-build -->
    <IlcLlvmRid Condition="'$(IlcLlvmRid)' == ''">linux-x64</IlcLlvmRid>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BytecodeAlliance.Componentize.DotNet.Wasm.SDK" Version="0.8.0-preview00011" />
    <PackageReference Include="runtime.$(IlcLlvmRid).microsoft.dotnet.ilcompiler.llvm" Version="10.0.0-rc.1.26306.1" />
  </ItemGroup>

  <!-- the SDK compiles in as sources; in the container it is mounted at /sdk-cs -->
  <Import Project="$(SdkCs)/Rs13.Mods.props" Condition="'$(SdkCs)' != ''" />
  <Import Project="../sdk-cs/Rs13.Mods.props" Condition="'$(SdkCs)' == ''" />

</Project>
