<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Template</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <UseAppHost>false</UseAppHost>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <!-- the assembly name is the package id and the prefix of every own path -->
    <AssemblyName>template</AssemblyName>
    <!-- the NativeAOT-LLVM compiler package is per build host -->
    <IlcLlvmRid Condition="'$(IlcLlvmRid)' == ''">linux-x64</IlcLlvmRid>
    <!-- the published SDK: three levels up from a package under mods/, two from the template itself -->
    <SdkCs Condition="'$(SdkCs)' == '' and Exists('../../../sdk/Rs13.Packs.props')">../../../sdk</SdkCs>
    <SdkCs Condition="'$(SdkCs)' == ''">../../sdk</SdkCs>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BytecodeAlliance.Componentize.DotNet.Wasm.SDK" Version="0.8.0-preview00011" />
    <PackageReference Include="runtime.$(IlcLlvmRid).microsoft.dotnet.ilcompiler.llvm" Version="10.0.0-rc.1.26306.1" />
  </ItemGroup>

  <Import Project="$(SdkCs)/Rs13.Packs.props" />

</Project>
